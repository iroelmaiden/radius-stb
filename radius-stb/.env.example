# ============================================
# HOTSPOT BILLING - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
DB_HOST=localhost
DB_NAME=radius
DB_USER=radius
DB_PASS=your_db_password_here

# --- FreeRADIUS ---
NAS_SECRET=your_radius_nas_secret_here

# --- MikroTik ---
MT_IP=192.168.1.1
MT_USER=admin
MT_PASS=your_mikrotik_password_here

# --- daloRADIUS ---
DALO_USER=administrator
DALO_PASS=your_daloradius_password_here

# --- Application ---
APP_NAME=Hotspot Billing
APP_URL=http://192.168.1.100:8081
